<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kênh Người Bán</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            overflow-x: hidden;
            background-color: #f4f6f9;
        }

        #sidebar-wrapper {
            min-height: 100vh;
            width: 260px;
            transition: all 0.25s ease-out;
            background-color: #212529;
        }

            #sidebar-wrapper .sidebar-heading {
                padding: 1.25rem 1rem;
                font-size: 1.2rem;
                font-weight: bold;
                background-color: #1a1d20;
                color: #ffffff;
            }

            #sidebar-wrapper .list-group-item {
                border: none;
                padding: 0.75rem 1.25rem;
                background-color: transparent;
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.92rem;
            }

                #sidebar-wrapper .list-group-item:hover {
                    background-color: rgba(255, 255, 255, 0.05);
                    color: #ffffff;
                }

                #sidebar-wrapper .list-group-item.active-menu {
                    background-color: #198754;
                    color: #ffffff;
                    font-weight: 500;
                    border-radius: 0.25rem;
                    margin: 0.2rem 0.5rem;
                }

        #page-content-wrapper {
            min-width: 0;
            width: 100%;
        }

        .seller-navbar {
            background-color: #ffffff;
            box-shadow: 0 1px 5px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="text-white" id="sidebar-wrapper">
            <div class="sidebar-heading text-center border-bottom border-secondary text-success">
                <i class="bi bi-shop"></i> KÊNH NGƯỜI BÁN
            </div>
            <div class="list-group list-group-flush mt-3">
                <a asp-area="" asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action text-warning">
                    <i class="bi bi-arrow-left-circle-fill me-2"></i> Quay về Trang Chủ
                </a>
                <hr class="dropdown-divider bg-secondary mx-3">

                <!-- 1. Tổng quan / Thống kê -->
                <a asp-area="Seller" asp-controller="Dashboard" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active-menu" : "")">
                    <i class="bi bi-speedometer2 me-2"></i> Tổng quan doanh thu
                </a>

                <!-- 2. Quản lý Sản phẩm -->
                <a asp-area="Seller" asp-controller="Products" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active-menu" : "")">
                    <i class="bi bi-box-seam me-2"></i> Quản lý Sản phẩm
                </a>

                <!-- 3. Quản lý Kho hàng -->
                <a asp-area="Seller" asp-controller="Inventory" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active-menu" : "")">
                    <i class="bi bi-boxes me-2"></i> Quản lý Kho hàng
                </a>

                <!-- 4. Quản lý Đơn hàng -->
                <a asp-area="Seller" asp-controller="Orders" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active-menu" : "")">
                    <i class="bi bi-receipt me-2"></i> Quản lý Đơn hàng
                </a>

                <!-- 5. Quản lý Khuyến mãi -->
                <a asp-area="Seller" asp-controller="Promotions" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Promotions" ? "active-menu" : "")">
                    <i class="bi bi-ticket-perforated me-2"></i> Mã giảm giá & KM
                </a>

                <!-- 6. Đánh giá của khách hàng -->
                <a asp-area="Seller" asp-controller="Reviews" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active-menu" : "")">
                    <i class="bi bi-star-fill me-2"></i> Đánh giá sản phẩm
                </a>

                <!-- 7. Cấu hình Cửa hàng -->
                <a asp-area="Seller" asp-controller="SellerProfile" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "SellerProfile" ? "active-menu" : "")">
                    <i class="bi bi-gear me-2"></i> Cài đặt Cửa hàng
                </a>
            </div>
        </div>

        <div id="page-content-wrapper" class="d-flex flex-column">
            <nav class="navbar navbar-expand-lg navbar-light seller-navbar py-3 px-4 d-flex justify-content-between">
                <div class="fw-bold text-secondary">
                    <i class="bi bi-calendar3"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")
                </div>

                <div class="dropdown">
                    <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="sellerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle text-success"></i> Người bán: @User.Identity?.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sellerDropdown">
                        <li>
                            <a class="dropdown-item" asp-area="Seller" asp-controller="SellerProfile" asp-action="Index">
                                <i class="bi bi-shop me-2"></i> Xem hồ sơ Shop
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>