<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Quản trị</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            overflow-x: hidden;
            background-color: #f4f6f9; /* Màu nền sáng và dịu hơn một chút */
        }

        /* Cấu hình thanh Sidebar */
        #sidebar-wrapper {
            min-height: 100vh;
            width: 250px;
            transition: all 0.25s ease-out;
            background-color: #212529; /* Nền tối */
        }

            #sidebar-wrapper .sidebar-heading {
                padding: 1.25rem 1rem;
                font-size: 1.2rem;
                font-weight: bold;
                background-color: #1a1d20;
                color: #ffffff; /* Sửa thành màu trắng cho thanh lịch */
            }

            #sidebar-wrapper .list-group-item {
                border: none;
                padding: 0.85rem 1.5rem;
                background-color: transparent; /* Giúp hover mượt hơn */
                color: rgba(255, 255, 255, 0.7); /* SỬA LỖI CÚ PHÁP TẠI ĐÂY */
                font-size: 0.95rem;
            }

                #sidebar-wrapper .list-group-item:hover {
                    background-color: rgba(255, 255, 255, 0.05); /* Hover nền sáng mờ thay vì xám đục */
                    color: #ffffff;
                }

                #sidebar-wrapper .list-group-item.active-menu {
                    background-color: #0d6efd;
                    color: #ffffff;
                    font-weight: 500;
                    border-radius: 0.25rem;
                    margin: 0.2rem 0.5rem; /* Bo góc và cách lề một chút nhìn sẽ hiện đại hơn */
                }

        /* Khu vực nội dung */
        #page-content-wrapper {
            min-width: 0;
            width: 100%;
        }

        .admin-navbar {
            background-color: #ffffff;
            box-shadow: 0 1px 5px rgba(0,0,0,0.05); /* Bóng đổ nhẹ nhàng hơn */
        }
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="text-white" id="sidebar-wrapper">
            <div class="sidebar-heading text-center border-bottom border-secondary text-info">
                <i class="bi bi-shield-lock-fill"></i> ADMIN DASHBOARD
            </div>
            <div class="list-group list-group-flush mt-3">
                <a asp-area="" asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action text-warning">
                    <i class="bi bi-arrow-left-circle-fill me-2"></i> Quay về Trang Chủ
                </a>
                <hr class="dropdown-divider bg-secondary mx-3">


                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active-menu" : "")">
                    <i class="bi bi-tags me-2"></i> Quản lý Danh mục
                </a>

                <a asp-area="Admin" asp-controller="Brands" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Brands" ? "active-menu" : "")">
                    <i class="bi bi-award me-2"></i> Quản lý Thương hiệu
                </a>

                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active-menu" : "")">
                    <i class="bi bi-people me-2"></i> Quản lý Người dùng
                </a>
            </div>
        </div>

        <div id="page-content-wrapper" class="d-flex flex-column">
            <nav class="navbar navbar-expand-lg navbar-light admin-navbar py-3 px-4 d-flex justify-content-between">
                <div class="fw-bold text-secondary">
                    <i class="bi bi-calendar3"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")
                </div>

                <div class="dropdown">
                    <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-badge-fill text-primary"></i> Xin chào, @User.Identity?.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>