@model DATN.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4>ĐĂNG KÝ THÀNH VIÊN ĐỒNG HÀNH</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="FullName" class="form-label">Họ và tên của bạn</label>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Email" class="form-label">Địa chỉ thư điện tử (Email)</label>
                            <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label">Mật khẩu bảo mật</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu để xác nhận</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="******" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 btn-lg">HOÀN THÀNH ĐĂNG KÝ</button>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Login">Đã có tài khoản hệ thống? Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}