@model DATN.Models.DTOs.PagedResult<DATN.Models.DTOs.OrderDto>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container mt-4">
    <h3 class="mb-4">Lịch sử mua hàng</h3>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info">Bạn chưa có đơn đặt hàng nào trong hệ thống.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt hàng</th>
                            <th>Tổng số tiền</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Items)
                        {
                            <tr>
                                <td>#@order.OrderID</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger font-weight-bold">@order.TotalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@order.OrderID" class="btn btn-info btn-sm text-white">Xem chi tiết đơn</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="MyOrders" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>