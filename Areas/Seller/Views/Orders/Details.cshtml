@using DATN.Areas.Seller.Models.DTOs
@model OrderDetailSellerDto

@{
    ViewData["Title"] = "Chi tiết đơn hàng Seller";
    Layout = "_SellerLayout";
}

<div class="container mt-4" style="max-width: 900px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Xử lý đơn đặt hàng số #@Model.OrderID</h4>
            <span class="badge bg-info text-dark">Trạng thái: @Model.Status</span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p>Khách hàng: <strong>@Model.CustomerName</strong></p>
                    <p>Thời gian đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>Phương thức thanh toán: <strong>@(Model.PaymentMethod ?? "COD")</strong></p>
                </div>
                <div class="col-md-6">
                    <p>Phí vận chuyển: @Model.ShippingFee.ToString("N0") đ</p>
                    <p>Giảm giá (Voucher): @Model.DiscountAmount.ToString("N0") đ</p>
                    <p>Tổng giá trị thanh toán: <strong class="text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</strong></p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="mb-3 alert alert-secondary">
                    <strong>Ghi chú của khách:</strong> @Model.Note
                </div>
            }

            <hr />

            <!-- Bảng danh sách sản phẩm trong đơn -->
            <h5 class="mb-3">Danh sách sản phẩm</h5>
            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        decimal grandTotal = 0;
                        foreach (var item in Model.OrderItems)
                        {
                            decimal totalItemPrice = item.Quantity * item.Price;
                            grandTotal += totalItemPrice;
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N0") đ</td>
                                <td class="text-end">@(totalItemPrice.ToString("N0") )đ</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng tiền :</td>
                                <td class="text-end fw-bold">@((grandTotal - Model.DiscountAmount).ToString("N0")) đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Không có sản phẩm nào trong đơn hàng.</td>
                        </tr>
                    }
                </tbody>
            </table>


            <hr />
            <form asp-area="Seller" asp-controller="Orders" asp-action="UpdateStatus" asp-route-id="@Model.OrderID" method="post" class="row g-3 align-items-center">
                @Html.AntiForgeryToken()
                <div class="col-auto">
                    <select name="status" class="form-select" required>
                        <option value="">-- Cập nhật trạng thái khác --</option>
                        <option value="Shipping">Đang vận chuyển giao hàng (Shipping)</option>
                        <option value="Delivered">Đã giao hàng thành công (Delivered)</option>
                        <option value="Cancelled">Hủy bỏ đơn giao dịch này (Cancelled)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Cập nhật</button>
                </div>
            </form>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-sm btn-secondary">Quay lại danh sách đơn hàng</a>
        </div>
    </div>
</div>