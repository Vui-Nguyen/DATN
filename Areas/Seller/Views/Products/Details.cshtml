@model DATN.Models.DTOs.ProductDetailDto

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "_SellerLayout";
}

<div class="container mt-4" style="max-width: 900px;">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Chi tiết sản phẩm: @Model.ProductName</h4>
            <a asp-action="Index" class="btn btn-light btn-sm">Quay lại danh sách</a>
        </div>
        <div class="card-body">
            <!-- Thông tin chung -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <p><strong>Mã sản phẩm:</strong> #@Model.ProductID</p>
                    <p><strong>Danh mục:</strong> @Model.CategoryName</p>
                    <p><strong>Thương hiệu:</strong> @Model.BrandName</p>
                    <p><strong>Ngày tạo:</strong> @Model.CreatedAt.?ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Cửa hàng:</strong> @Model.ShopName</p>
                    <p><strong>Mô tả chi tiết:</strong></p>
                    <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)</p>
                </div>
            </div>

            <!-- Hình ảnh sản phẩm -->
            <div class="mb-4">
                <h5 class="fw-bold">Bộ sưu tập hình ảnh</h5>
                @if (Model.Images != null && Model.Images.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var img in Model.Images)
                        {
                            <img src="@img" alt="Product Image" class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Không có hình ảnh nào.</p>
                }
            </div>

            <!-- Danh sách biến thể / phân loại -->
            <div class="mb-3">
                <h5 class="fw-bold">Danh sách phân loại sản phẩm</h5>
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>STT</th>
                            <th>Tên phân loại</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Variants != null && Model.Variants.Count > 0)
                        {
                            int i = 0;
                            foreach (var v in Model.Variants)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td><strong>@v.VariantName</strong></td>
                                    <td><span class="badge bg-success">@v.Price.ToString("N0") đ</span></td>
                                    <td>@v.Stock</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">Không có phân loại nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Nút thao tác -->
            <div class="d-flex gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-warning">Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>