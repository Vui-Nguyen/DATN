@using DATN.Models.DTOs
@model OrderDetailDto

@{
    var address = ViewBag.Address as string ?? "Chưa có địa chỉ giao hàng";
    ViewData["Title"] = "Chi tiết hóa đơn đơn hàng";
    Layout = "_Layout"; 
}

<div class="container mt-4" style="max-width: 700px;">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Chi tiết đơn đặt hàng số #@Model.OrderID</h4>
            <span class="badge bg-light text-dark">Trạng thái: @Model.Status</span>
        </div>
        <div class="card-body">
            <p>Thời gian ghi nhận: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p>Phí vận chuyển: <strong>@Model.ShippingFee.ToString("N0") đ</strong></p>
            <p>Số tiền giảm giá (Voucher): <strong>@Model.DiscountAmount.ToString("N0") đ</strong></p>
            <p>
                Địa chỉ giao hàng: @address
            </p>

            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <p>Ghi chú của bạn: <em>@Model.Note</em></p>
            }

            <p>Tổng giá trị thanh toán: <strong class="text-danger text-large">@Model.TotalAmount.ToString("N0") đ</strong></p>
            <hr />

            <h5 class="mb-3">Danh sách sản phẩm trong đơn:</h5>
            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N0") đ</td>
                                <td class="text-end">@((item.Quantity * item.Price).ToString("N0")) đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Không có sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <hr />
            @if(Model.Status == "Pending")
            {
                <div class="d-flex gap-2 mb-3">
                    <form asp-action="CancelOrder" asp-route-id="@Model.OrderID" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Hủy bỏ đơn giao dịch này (Cancelled)</button>
                    </form>
                </div>
            }
        </div>
        <div class="card-footer">
            <a asp-action="MyOrders" class="btn btn-sm btn-secondary">Quay lại danh sách đơn hàng</a>
        </div>
    </div>
</div>