@model DATN.Models.ViewModels.VoucherViewModel

@{
    ViewData["Title"] = "Thêm mới Voucher";
    Layout = "_SellerLayout";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thêm mã giảm giá mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Hiển thị tổng hợp lỗi model nếu có -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="VoucherCode" class="form-label">Mã Voucher <span class="text-danger">*</span></label>
                    <input asp-for="VoucherCode" class="form-control" placeholder="VD: SALE50, TET2026..." />
                    <span asp-validation-for="VoucherCode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiscountPercent" class="form-label">Phần trăm giảm (%) <span class="text-danger">*</span></label>
                    <input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" placeholder="VD: 10, 20.5..." />
                    <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Ngày bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Ngày kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Số lượng mã <span class="text-danger">*</span></label>
                    <input asp-for="Quantity" type="number" class="form-control" placeholder="VD: 100" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                    <button type="submit" class="btn btn-success">Lưu Voucher</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        // Kích hoạt Client-side validation (jquery validate) nếu project của bạn có dùng
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}