@model DATN.Models.DTOs.PagedResult<DATN.Models.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý danh mục sản phẩm</h2>
        <div class="d-flex gap-2">
            <!-- Nút chuyển sang trang Duyệt đề xuất -->
            <a asp-area="Admin" asp-controller="Categories" asp-action="Pending" class="btn btn-outline-warning">
                <i class="bi bi-clock-history"></i> Duyệt đề xuất mới
            </a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;">Mã ID</th>
                            <th>Tên danh mục</th>
                            <th style="width: 200px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            @foreach (var cat in Model.Items)
                            {
                                <tr>
                                    <td>#@cat.CategoryID</td>
                                    <td><strong>@cat.CategoryName</strong></td>
                                    <td class="text-center">
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@cat.CategoryID" class="btn btn-sm btn-warning me-1">Sửa</a>
                                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@cat.CategoryID" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn chắc chắn muốn xóa danh mục này?')">Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Thanh phân trang -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <small class="text-muted">Tổng cộng: <strong>@Model.TotalItems</strong> danh mục</small>
                    <nav>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Sau</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>