@model DATN.Models.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    Layout = "_Layout";
}

<div class="container my-4">
    <h2 class="mb-4">Xác nhận đơn hàng</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="CreateOrder" method="post" class="row">
        <input type="hidden" asp-for="AddressId" id="AddressIdHidden" />
        <input type="hidden" asp-for="SelectedVoucherId" />

        @for (int i = 0; i < Model.SelectedCartItemIds.Count; i++)
        {
            <input type="hidden" name="SelectedCartItemIds[@i]" value="@Model.SelectedCartItemIds[i]" />
        }

        <!-- Cột trái -->
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">1. Địa chỉ giao hàng</h5>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Chọn từ sổ địa chỉ</label>
                        <select class="form-control" id="addressSelect">
                            @foreach (var addr in Model.UserAddresses)
                            {
                                var isSelected = Model.AddressId > 0
                                ? addr.AddressID == Model.AddressId
                                : addr.IsDefault == true;

                                <option value="@addr.AddressID"
                                        data-name="@addr.ReceiverName"
                                        data-phone="@addr.Phone"
                                        data-detail="@addr.AddressDetail"
                                        selected="@isSelected">
                                    @addr.ReceiverName - @addr.Phone - @addr.AddressDetail @(addr.IsDefault == true ? "(Mặc định)" : "")
                                </option>
                            }
                            <option value="new" class="text-primary font-weight-bold">+ Thêm địa chỉ mới...</option>
                        </select>
                        <span asp-validation-for="AddressId" class="text-danger"></span>
                    </div>

                    <hr />
                    <h6 class="text-secondary mb-3">Thông tin nhận hàng chi tiết</h6>

                    <div class="mb-3">
                        <label class="form-label">Tên người nhận hàng</label>
                        <p id="ReceiverNameDisplay" class="form-control-plaintext font-weight-bold text-dark bg-light p-2 rounded border"></p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại nhận hàng</label>
                        <p id="PhoneDisplay" class="form-control-plaintext font-weight-bold text-dark bg-light p-2 rounded border"></p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Chi tiết địa chỉ giao hàng</label>
                        <p id="AddressDetailDisplay" class="form-control-plaintext font-weight-bold text-dark bg-light p-2 rounded border"></p>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label">Ghi chú đơn hàng</label>
                        <textarea asp-for="Note" class="form-control" rows="2" placeholder="Lưu ý cho người giao hàng..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Chọn mã giảm giá (Voucher)</label>
                        <select id="voucherSelect" class="form-select" onchange="changeVoucher(this.value)">
                            <option value="">-- Không sử dụng voucher --</option>
                            @foreach (var v in Model.AvailableVouchers)
                            {
                                <option value="@v.VoucherID" selected="@(Model.SelectedVoucherId == v.VoucherID)">
                                    [@v.VoucherCode] Giảm @v.DiscountPercent% (Hạn đến: @v.EndDate?.ToString("dd/MM/yyyy"))
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">2. Phương thức thanh toán</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" id="pmCOD" asp-for="PaymentMethod" value="COD" />
                        <label class="form-check-label" for="pmCOD">Thanh toán khi nhận hàng (COD)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="pmBanking" asp-for="PaymentMethod" value="Banking" />
                        <label class="form-check-label" for="pmBanking">Chuyển khoản ngân hàng</label>
                    </div>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Cột phải -->
        <div class="col-md-5">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">3. Sản phẩm trong đơn</h5>

                    @if (Model.CartItems.Any())
                    {
                        <div class="table-responsive mb-3" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end">Tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="text-truncate" style="max-width: 150px;" title="@item.ProductName">@item.ProductName</div>
                                                <small class="text-muted">@item.Price.ToString("N0") đ</small>
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-danger">Giỏ hàng trống.</p>
                    }

                    <hr />

                    @* Chỉ hiện khung lỗi khi thật sự có lỗi *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <strong>@Model.ItemsTotal.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <strong>@Model.ShippingFee.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giảm giá:</span>
                        <strong class="text-danger">-@Model.DiscountAmount.ToString("N0") đ</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <span class="h5 font-weight-bold">Tổng thanh toán:</span>
                        <strong class="h5 text-danger">@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 font-weight-bold">Đặt hàng ngay</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const selectedCartItemIds = @Json.Serialize(Model.SelectedCartItemIds);

        function handleAddressChange() {
            const select = document.getElementById('addressSelect');
            if (!select || select.options.length === 0) return;

            const opt = select.options[select.selectedIndex];

            if (opt.value === 'new') {
                window.location.href = '@Url.Action("CreateAdd", "Account")';
                return;
            }

            document.getElementById('ReceiverNameDisplay').innerText = opt.getAttribute('data-name') || '';
            document.getElementById('PhoneDisplay').innerText = opt.getAttribute('data-phone') || '';
            document.getElementById('AddressDetailDisplay').innerText = opt.getAttribute('data-detail') || '';

            document.getElementById('AddressIdHidden').value = opt.value;
        }

        // Đổi voucher: tải lại trang, giữ nguyên sản phẩm đã chọn và địa chỉ đang chọn
        function changeVoucher(voucherId) {
            const params = new URLSearchParams();
            selectedCartItemIds.forEach(id => params.append('selectedCartItemIds', id));

            if (voucherId) params.append('voucherId', voucherId);

            const addressId = document.getElementById('addressSelect').value;
            if (addressId && addressId !== 'new') params.append('addressId', addressId);

            // Url.Action không chỉ định controller -> dùng đúng controller hiện tại (Cart)
            window.location.href = '@Url.Action("CreateOrder")?' + params.toString();
        }

        document.getElementById('addressSelect')?.addEventListener('change', handleAddressChange);
        document.addEventListener('DOMContentLoaded', handleAddressChange);
    </script>
}
