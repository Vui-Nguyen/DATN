@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <!-- Icon thành công -->
                    <div class="mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#28a745" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                    </div>

                    <h2 class="text-success fw-bold mb-3">Thanh toán thành công!</h2>

                    <!-- Thông báo truyền từ Controller qua ViewBag -->
                    <p class="text-muted mb-4">@ViewBag.Message</p>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 gap-3">Về trang chủ</a>
                        <!-- Nếu bạn có trang xem chi tiết đơn hàng, hãy thay đường dẫn bên dưới -->
                        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary px-4">Xem lịch sử đơn hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>