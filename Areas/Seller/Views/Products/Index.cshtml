@model DATN.Models.DTOs.PagedResult<DATN.Areas.Admin.Models.DTOs.ProductAdminDto>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sản phẩm trong hệ thống</h2>
        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus"></i> Thêm sản phẩm mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên mặt hàng sản phẩm</th>
                        <th>Thuộc danh mục</th>
                        <th>Thương hiệu</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.Items)
                    {
                        <tr>
                            <td>#@prod.ProductID</td>
                            <td><strong>@prod.ProductName</strong></td>
                            <td><span class="badge bg-secondary">@prod.CategoryName</span></td>
                            <td>@prod.BrandName</td>
                            <td class="text-center">
                                <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@prod.ProductID" class="btn btn-sm btn-info text-white">Sửa</a>
                                <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@prod.ProductID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xóa sản phẩm này?')">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>