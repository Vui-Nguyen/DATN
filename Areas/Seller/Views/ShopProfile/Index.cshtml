@model ShopResponseDto

@{
    ViewData["Title"] = "Quản lý Shop";
    Layout = "_SellerLayout";
}

<!-- Nhúng Bootstrap Icons (nếu dự án của bạn chưa có) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Card Tổng Thể -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header Card (Banner giả lập màu gradient đẹp mắt) -->
                <div class="card-header bg-gradient bg-primary text-white py-4 px-4 position-relative" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1 fw-bold"><i class="bi bi-shop me-2"></i>Hồ Sơ Shop Của Tôi</h4>
                            <p class="mb-0 text-white-50 small">Quản lý thông tin và trạng thái cửa hàng trên hệ thống</p>
                        </div>
                        <div>
                            @if (Model.IsLocked)
                            {
                                <span class="badge bg-danger bg-gradient px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-lock-fill me-1"></i> Đang bị khóa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-gradient px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Thân Card -->
                <div class="card-body p-4 p-lg-5 bg-light">
                    <div class="row align-items-center g-4">

                        <!-- Cột Trái: Avatar & Tên Shop -->
                        <div class="col-lg-4 text-center border-end-lg">
                            <div class="position-relative d-inline-block mb-3">
                                @if (!string.IsNullOrEmpty(Model.AvatarShop))
                                {
                                    <img src="@Model.AvatarShop" alt="Avatar Shop" class="rounded-circle shadow border border-4 border-white" style="width: 140px; height: 140px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="/images/default-avatar.png" alt="Default Avatar" class="rounded-circle shadow border border-4 border-white bg-white" style="width: 140px; height: 140px; object-fit: cover;" />
                                }
                                <span class="position-absolute bottom-0 end-0 p-2 bg-primary border border-light rounded-circle text-white shadow-sm" title="Ảnh đại diện shop">
                                    <i class="bi bi-camera-fill small"></i>
                                </span>
                            </div>

                            <h4 class="fw-bold text-dark mb-1">@Model.ShopName</h4>
                            <p class="text-muted small mb-3">Mã Shop: <span class="fw-semibold text-secondary">#@Model.ShopID</span></p>

                            <div class="d-grid gap-2 col-10 mx-auto">
                                <a asp-action="UpdateShop" asp-route-shopId="@Model.ShopID" class="btn btn-primary rounded-pill shadow-sm py-2">
                                    <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin
                                </a>
                            </div>
                        </div>

                        <!-- Cột Phải: Chi Tiết Thông Tin -->
                        <div class="col-lg-8 ps-lg-4">
                            <div class="bg-white p-4 rounded-4 shadow-sm border">
                                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-info-circle text-primary me-2"></i>Thông tin chi tiết
                                </h5>

                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted fw-semibold">
                                        <i class="bi bi-card-text me-1"></i> Tên Shop:
                                    </div>
                                    <div class="col-sm-8 text-dark fw-bold text-primary">
                                        @Model.ShopName
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted fw-semibold">
                                        <i class="bi bi-file-text me-1"></i> Mô tả:
                                    </div>
                                    <div class="col-sm-8 text-secondary">
                                        @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả nào cho cửa hàng này." : Model.Description)
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-4 text-muted fw-semibold">
                                        <i class="bi bi-calendar-check me-1"></i> Ngày tạo:
                                    </div>
                                    <div class="col-sm-8 text-dark">
                                        @Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer Card -->
                <div class="card-footer bg-white border-0 py-3 px-4 text-end">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>