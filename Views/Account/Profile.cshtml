
@model DATN.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <h4 class="mb-0"><i class="bi bi-person-bounding-box"></i> THÔNG TIN TÀI KHOẢN</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted fw-bold">Mã định danh (ID)</label>
                                <input class="form-control bg-light" value="#@Model.UserID" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted fw-bold">Địa chỉ Email (Tên đăng nhập)</label>
                                <input class="form-control bg-light" value="@Model.Email" readonly />
                                <small class="text-muted">Liên hệ Admin để yêu cầu đổi Email.</small>
                            </div>
                        </div>

                        <hr />

                        <h5 class="text-secondary mb-3"><i class="bi bi-pencil-square"></i> Cập nhật thông tin công khai</h5>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Họ và tên của bạn</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Ô Số điện thoại -->
                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại liên hệ</label>
                            <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0912345678" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại mua sắm
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light d-flex justify-content-around py-3">
                    <span class="text-muted">Nhóm quyền hiện tại: <strong class="text-dark">@Model.RoleName</strong></span>
                    <div class="d-flex gap-3">
                        @* Tùy chỉnh tên Role "Seller" cho đúng với Database của bạn (VD: "Người bán", "Vendor", v.v.) *@
                        @if (Model.RoleName != "Seller" && Model.RoleName != "Admin")
                        {
                            @if (ViewBag.SellerStatus == null)
                            {
                                <a asp-controller="Account" asp-action="RegisterSeller" class="text-decoration-none text-success fw-bold">
                                    <i class="bi bi-shop"></i> Đăng ký làm Seller
                                </a>
                            }
                            else if (ViewBag.SellerStatus == 0)
                            {
                                <span class="text-warning fw-bold">
                                    <i class="bi bi-hourglass-split"></i> Đang chờ Admin duyệt lên Seller...
                                </span>
                            }
                            else if (ViewBag.SellerStatus == 2)
                            {
                                <span class="text-danger fw-bold">
                                    <i class="bi bi-x-circle"></i> Đăng ký Seller bị từ chối
                                </span>
                                <a asp-controller="Account" asp-action="RegisterSeller" class="btn btn-sm btn-outline-danger ms-2">Đăng ký lại</a>
                            }
                            <span class="text-muted">|</span>
                        }
                    <a asp-action="ChangePassword" class="text-decoration-none text-danger fw-bold">
                        <i class="bi bi-shield-lock"></i> Thay đổi mật khẩu tài khoản?
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}