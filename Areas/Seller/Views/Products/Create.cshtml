@model DATN.Areas.Seller.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_AdminLayout";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4>Đăng ký thông tin sản phẩm mới</h4>
        </div>
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label">Tên sản phẩm</label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryID" class="form-label">Chọn danh mục sản phẩm</label>
                        <select asp-for="CategoryID" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">-- Vui lòng chọn --</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandID" class="form-label">Chọn thương hiệu phân phối</label>
                        <select asp-for="BrandID" class="form-select" asp-items="ViewBag.Brands">
                            <option value="">-- Vui lòng chọn --</option>
                        </select>
                        <span asp-validation-for="BrandID" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả thông số chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Tải lên bộ sưu tập hình ảnh sản phẩm</label>
                    <input type="file" name="images" class="form-control" multiple accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">Tạo sản phẩm</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>