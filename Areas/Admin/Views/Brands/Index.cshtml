@model IEnumerable<DATN.Models.DTOs.BrandDto>

@{
    ViewData["Title"] = "Quản lý thương hiệu";
    Layout = "_AdminLayout"; // Đảm bảo bạn có file layout riêng cho admin
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý thương hiệu sản phẩm</h2>
        <a asp-area="Admin" asp-controller="Brands" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm thương hiêu mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Mã ID</th>
                        <th>Tên thương hiệu</th>
                        <th style="width: 200px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>#@cat.BrandID</td>
                            <td><strong>@cat.BrandName</strong></td>
                            <td class="text-center">
                                <a asp-area="Admin" asp-controller="Brands" asp-action="Edit" asp-route-id="@cat.BrandID" class="btn btn-sm btn-warning">Sửa</a>
                                <form asp-area="Admin" asp-controller="Brands" asp-action="Delete" asp-route-id="@cat.BrandID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn chắc chắn muốn xóa thương hiệu này?')">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>