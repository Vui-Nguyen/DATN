@model DATN.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container my-4">
    <h2>Thanh toán đơn hàng</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Checkout" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h4 class="mb-3">Thông tin giao hàng</h4>

                <!-- Dropdown chọn địa chỉ từ sổ địa chỉ -->
                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Chọn địa chỉ giao hàng có sẵn:</label>
                    <select asp-for="SelectedAddressId" class="form-select" id="addressSelect">
                        @if (Model.UserAddresses != null && Model.UserAddresses.Count > 0)
                        {
                            @foreach (var item in Model.UserAddresses)
                            {
                                <option value="@item.AddressID"
                                        data-name="@item.ReceiverName"
                                        data-phone="@item.Phone"
                                        data-detail="@item.AddressDetail">
                                    @item.ReceiverName - @item.Phone - @item.AddressDetail @(item.IsDefault == true ? "(Mặc định)" : "")
                                </option>
                            }
                        }
                        else
                        {
                            <option value="">-- Bạn chưa có địa chỉ nào, vui lòng thêm mới --</option>
                        }
                    </select>
                </div>

                <!-- Nút chuyển hướng sang trang thêm địa chỉ mới nếu cần -->
                <div class="mb-3">
                    <a asp-controller="Account" asp-action="CreateAdd" class="btn btn-outline-primary btn-sm">+ Thêm địa chỉ mới</a>
                </div>

                <!-- Khu vực hiển thị thông tin chi tiết (Chỉ để xem lại, không cho phép gõ tự do) -->
                <div class="card p-3 bg-light mb-4">
                    <p class="mb-1"><strong>Họ tên người nhận:</strong> <span id="lblReceiverName">@Model.ReceiverName</span></p>
                    <p class="mb-1"><strong>Số điện thoại:</strong> <span id="lblPhone">@Model.Phone</span></p>
                    <p class="mb-0"><strong>Địa chỉ chi tiết:</strong> <span id="lblAddressDetail">@Model.AddressDetail</span></p>
                </div>

                <!-- Các trường ẩn để bind dữ liệu về Model cũ (phòng trường hợp backend cũ cần đọc trực tiếp) -->
                <input type="hidden" asp-for="ReceiverName" id="hiddenReceiverName" />
                <input type="hidden" asp-for="Phone" id="hiddenPhone" />
                <input type="hidden" asp-for="AddressDetail" id="hiddenAddressDetail" />

                <h4 class="mb-3 mt-4">Phương thức thanh toán</h4>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="COD" checked />
                    <label class="form-check-label" for="PaymentMethod">
                        Thanh toán khi nhận hàng (COD)
                    </label>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="BankTransfer" />
                    <label class="form-check-label" for="PaymentMethod">
                        Chuyển khoản ngân hàng
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Đặt hàng</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Script tự động đổi thông tin hiển thị và gán vào input ẩn khi người dùng thay đổi địa chỉ
        const addressSelect = document.getElementById('addressSelect');
        if (addressSelect) {
            addressSelect.addEventListener('change', function () {
                var selectedOption = this.options[this.selectedIndex];

                var name = selectedOption.getAttribute('data-name') || '';
                var phone = selectedOption.getAttribute('data-phone') || '';
                var detail = selectedOption.getAttribute('data-detail') || '';

                // Hiển thị ra màn hình giao diện
                document.getElementById('lblReceiverName').innerText = name;
                document.getElementById('lblPhone').innerText = phone;
                document.getElementById('lblAddressDetail').innerText = detail;

                // Gán ngầm vào các input ẩn để gửi về Model
                document.getElementById('hiddenReceiverName').value = name;
                document.getElementById('hiddenPhone').value = phone;
                document.getElementById('hiddenAddressDetail').value = detail;
            });
        }
    </script>
}