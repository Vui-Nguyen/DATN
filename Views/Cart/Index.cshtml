@model DATN.Models.DTOs.CartDto

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container mt-4">
    <h3 class="mb-4"><i class="bi bi-cart"></i> Giỏ hàng của bạn</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-warning text-center py-5 shadow-sm">
            <h5>Giỏ hàng đang trống!</h5>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 150px;">Số lượng</th>
                                    <th>Tổng tiền</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td><strong>@item.ProductName</strong></td>
                                        <td>@item.Price.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartItemId" value="@item.CartItemID" />
                                                <input type="number" name="quantity" class="form-control form-control-sm me-1" value="@item.Quantity" min="1" onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td class="text-danger font-weight-bold">@item.TotalPrice.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="RemoveItem" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartItemId" value="@item.CartItemID" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Xóa sản phẩm này?')">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Khối tổng kết số tiền -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Tóm tắt đơn hàng</h5>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tổng tiền thanh toán:</span>
                            <span class="text-danger font-weight-bold fs-5">@Model.Items.Sum(i => i.TotalPrice).ToString("N0") đ</span>
                        </div>
                        <a asp-action="Checkout" class="btn btn-success w-100 btn-lg">TIẾN HÀNH ĐẶT HÀNG</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>