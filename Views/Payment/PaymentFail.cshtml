@{
    ViewData["Title"] = "Thanh toán thất bại";
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <!-- Icon thất bại -->
                    <div class="mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#dc3545" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM4.646 4.646a.5.5 0 0 0 .708.708L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                    </div>

                    <h2 class="text-danger fw-bold mb-3">Thanh toán thất bại!</h2>

                    <!-- Thông báo lỗi truyền từ Controller qua ViewBag -->
                    <p class="text-muted mb-4">@ViewBag.Message</p>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary px-4 gap-3">Quay lại giỏ hàng</a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-danger px-4">Về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>