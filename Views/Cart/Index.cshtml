@model DATN.Models.DTOs.CartDto

@{
    ViewData["Title"] = "Giỏ hàng của bạn";

    // Nhóm các sản phẩm trong giỏ hàng theo ShopId / ShopName
    var groupedItems = Model?.Items?.GroupBy(i => new { i.ShopId, i.ShopName }) ?? Enumerable.Empty<IGrouping<object, DATN.Models.DTOs.CartItemDto>>();
}

<div class="container mt-4">
    <h3 class="mb-4"><i class="bi bi-cart"></i> Giỏ hàng của bạn</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-warning text-center py-5 shadow-sm">
            <h5>Giỏ hàng đang trống!</h5>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        var groupedCartItems = Model.Items.GroupBy(i => new { i.ShopId, i.ShopName });
        <form asp-controller="Order" asp-action="CreateOrder" method="get" id="checkoutForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-8">
                    <!-- ĐÃ BỎ PHẦN CHỌN TẤT CẢ Ở ĐÂY -->
                    <!-- Hiển thị nhóm theo Shop -->
                    @foreach (var shopGroup in groupedCartItems)
                    {
                        <div class="card shadow-sm mb-4">
                            <!-- Tên Shop -->
                            <div class="card-header bg-white d-flex align-items-center py-3">
                                <div class="form-check me-2 mb-0">
                                    <!-- Thêm sự kiện onchange cho Checkbox của Shop -->
                                    <input class="form-check-input shop-checkbox" type="checkbox" data-shop-id="@shopGroup.Key.ShopId" onchange="handleShopSelection(this)">
                                </div>
                                <span class="fw-bold text-dark"><i class="bi bi-shop"></i> @shopGroup.Key.ShopName</span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 40px;"></th>
                                            <th>Sản phẩm</th>
                                            <th>Đơn giá</th>
                                            <th style="width: 130px;">Số lượng</th>
                                            <th>Tổng tiền</th>
                                            <th>Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in shopGroup)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="form-check">
                                                        <!-- Checkbox chọn sản phẩm, chứa data-shop-id để ràng buộc -->
                                                        <input class="form-check-input product-checkbox" type="checkbox"
                                                               name="selectedCartItemIds" value="@item.CartItemID"
                                                               data-shop-id="@item.ShopId" onchange="handleProductSelection()">
                                                    </div>
                                                </td>
                                                <td><strong>@item.ProductName</strong></td>
                                                <td>@item.Price.ToString("N0") đ</td>
                                                <td>
                                                    <div class="d-flex">
                                                        <input type="number" class="form-control form-control-sm me-1 quantity-input"
                                                               data-id="@item.CartItemID" value="@item.Quantity" min="1" readonly />
                                                    </div>
                                                </td>
                                                <td class="text-danger font-weight-bold item-total">@item.TotalPrice.ToString("N0") đ</td>
                                                <td>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItem('@item.CartItemID')">Xóa</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- Khối tổng kết số tiền & thanh toán -->
                <div class="col-md-4">
                    <div class="card shadow-sm sticky-top" style="top: 20px;">
                        <div class="card-body">
                            <h5 class="card-title">Tóm tắt đơn hàng</h5>
                            <hr />
                            <div class="d-flex justify-content-between mb-3">
                                <span>Tổng thanh toán:</span>
                                <span class="text-danger font-weight-bold fs-5" id="totalPaymentAmount">0 đ</span>
                            </div>
                            <button type="submit" class="btn btn-success w-100 btn-lg" id="btnCheckout" disabled>TIẾN HÀNH ĐẶT HÀNG</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Xử lý khi tick/bỏ tick checkbox của Shop
        function handleShopSelection(shopCb) {
            const shopId = shopCb.getAttribute('data-shop-id');
            const isChecked = shopCb.checked;

            // Tìm tất cả checkbox sản phẩm thuộc shop này
            const productsInShop = document.querySelectorAll(`.product-checkbox[data-shop-id="${shopId}"]`);

            productsInShop.forEach(cb => {
                if (!cb.disabled) { // Chỉ thay đổi nếu sản phẩm không bị disable (do đang chọn shop khác)
                    cb.checked = isChecked;
                }
            });

            // Gọi hàm xử lý chung để disable các shop khác và tính tổng tiền
            handleProductSelection();
        }

        // Logic xử lý khi chọn sản phẩm
        function handleProductSelection() {
            const productCheckboxes = document.querySelectorAll('.product-checkbox');
            const shopCheckboxes = document.querySelectorAll('.shop-checkbox');
            const checkedBoxes = Array.from(productCheckboxes).filter(cb => cb.checked);

            if (checkedBoxes.length > 0) {
                // Lấy ShopId của sản phẩm đầu tiên được chọn
                const activeShopId = checkedBoxes[0].getAttribute('data-shop-id');

                // Xử lý Checkbox Sản phẩm
                productCheckboxes.forEach(cb => {
                    if (cb.getAttribute('data-shop-id') !== activeShopId) {
                        cb.disabled = true;
                        cb.closest('tr').style.opacity = '0.5';
                    } else {
                        cb.disabled = false;
                        cb.closest('tr').style.opacity = '1';
                    }
                });

                // Xử lý Checkbox Shop
                shopCheckboxes.forEach(cb => {
                    if (cb.getAttribute('data-shop-id') !== activeShopId) {
                        cb.disabled = true;
                        cb.checked = false; // Bỏ tick các shop khác
                    } else {
                        cb.disabled = false;
                        // Kiểm tra xem đã tick hết sản phẩm của shop này chưa, nếu rồi thì tự động tick ô Shop
                        const shopProducts = document.querySelectorAll(`.product-checkbox[data-shop-id="${activeShopId}"]`);
                        const allChecked = Array.from(shopProducts).every(p => p.checked);
                        cb.checked = allChecked;
                    }
                });
            } else {
                // Nếu không có sản phẩm nào được chọn thì mở lại tất cả checkbox
                productCheckboxes.forEach(cb => {
                    cb.disabled = false;
                    cb.closest('tr').style.opacity = '1';
                });
                shopCheckboxes.forEach(cb => {
                    cb.disabled = false;
                    cb.checked = false;
                });
            }

            calculateTotal();
        }

        // Tính tổng tiền các sản phẩm được chọn
        function calculateTotal() {
            let total = 0;
            const checkedBoxes = document.querySelectorAll('.product-checkbox:checked');

            checkedBoxes.forEach(cb => {
                const row = cb.closest('tr');
                const totalText = row.querySelector('.item-total').innerText;
                const numericPrice = parseInt(totalText.replace(/\D/g, '')) || 0;
                total += numericPrice;
            });

            document.getElementById('totalPaymentAmount').innerText = total.toLocaleString('vi-VN') + ' đ';

            // Bật/tắt nút đặt hàng
            const btnCheckout = document.getElementById('btnCheckout');
            if (checkedBoxes.length > 0) {
                btnCheckout.disabled = false;
            } else {
                btnCheckout.disabled = true;
            }
        }

        // Hàm xóa sản phẩm
        function removeItem(cartItemId) {
            if (confirm('Xóa sản phẩm này?')) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '/Cart/RemoveItem';

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenInput = token.cloneNode(true);
                    form.appendChild(tokenInput);
                }

                const inputId = document.createElement('input');
                inputId.type = 'hidden';
                inputId.name = 'cartItemId';
                inputId.value = cartItemId;
                form.appendChild(inputId);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}