@model DATN.Areas.Seller.Models.ViewModels.ShopViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin Shop";
    Layout = "_SellerLayout";
    int shopId = ViewBag.ShopId ?? 0;
}

<!-- Nhúng Bootstrap Icons (nếu dự án chưa có) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Card Tổng Thể -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header Card -->
                <div class="card-header bg-gradient bg-primary text-white py-4 px-4" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <span class="bg-white text-primary p-3 rounded-circle shadow-sm d-inline-flex">
                                <i class="bi bi-pencil-square fs-4"></i>
                            </span>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold">Chỉnh Sửa Thông Tin Shop</h4>
                            <p class="mb-0 text-white-50 small">Cập nhật tên, mô tả và hình ảnh đại diện cho cửa hàng của bạn</p>
                        </div>
                    </div>
                </div>

                <!-- Thân Card / Form -->
                <div class="card-body p-4 p-lg-5 bg-light">

                    <!-- Hiển thị thông báo thành công nếu có -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="UpdateShop" asp-route-shopId="@shopId" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <!-- Tên Shop -->
                        <div class="mb-4">
                            <label asp-for="ShopName" class="form-label fw-semibold text-dark">Tên Shop</label>
                            <input asp-for="ShopName" class="form-control form-control-lg rounded-3 shadow-sm" />
                            <span asp-validation-for="ShopName" class="text-danger small"></span>
                        </div>

                        <!-- Chọn File Avatar từ máy -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-image me-1 text-primary"></i> Tải ảnh đại diện từ máy
                            </label>
                            <input type="file" name="avatarShopFile" class="form-control form-control-lg rounded-3 shadow-sm" accept="image/*" />
                            <div class="form-text text-muted small mt-1">Hỗ trợ các định dạng: .jpg, .jpeg, .png</div>
                        </div>

                        <!-- Mô tả -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-dark">Mô tả cửa hàng</label>
                            <textarea asp-for="Description" class="form-control rounded-3 shadow-sm" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Quay lại</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow">Lưu thay đổi</button>
                        </div>
                    </form>

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}