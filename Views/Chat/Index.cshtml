@{
    Layout = "_Layout";
    ViewData["Title"] = "Tin nhắn";
    var currentUserId = ViewBag.CurrentUserId as string;
    var currentConversationId = ViewBag.CurrentConversationId as int?;

    // Lấy thông tin Shop đang chat cùng để hiển thị trên Header
    var activeConversation = (ViewBag.Conversations as IEnumerable<DATN.Models.DTOs.ConversationDto>)
                             ?.FirstOrDefault(c => c.ConversationId == currentConversationId);
}

<style>
    /* Tổng thể App Chat */
    .messenger-app {
        display: flex;
        height: 70vh; /* Chiều cao tổng thể */
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        overflow: hidden;
    }

    /* --- CỘT TRÁI: DANH SÁCH CHAT --- */
    .messenger-sidebar {
        width: 350px;
        border-right: 1px solid #e0e0e0;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    .sidebar-header {
        padding: 15px;
        font-size: 20px;
        font-weight: 700;
        border-bottom: 1px solid #f0f2f5;
    }

    .chat-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

    .chat-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border-radius: 8px;
        text-decoration: none !important;
        color: #050505;
        transition: background-color 0.2s;
        cursor: pointer;
        margin-bottom: 2px;
    }

        .chat-item:hover {
            background-color: #f2f2f2;
        }

        .chat-item.active {
            background-color: #ebf5ff; /* Màu xanh nhạt */
        }

    .avatar-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #e4e6eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #606770;
        margin-right: 12px;
        flex-shrink: 0;
        overflow: hidden;
    }

        .avatar-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .chat-item-info {
        flex: 1;
        overflow: hidden;
    }

    .chat-item-name {
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 2px;
    }

    .chat-item-preview {
        font-size: 13px;
        color: #65676b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-item.active .chat-item-name {
        color: #0064d1;
    }

    /* --- CỘT PHẢI: KHUNG CHAT --- */
    .messenger-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    .chat-header {
        padding: 15px;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        z-index: 2;
    }

    .chat-header-name {
        font-weight: 600;
        font-size: 17px;
    }

    .messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        background: #ffffff;
        display: flex;
        flex-direction: column;
    }

    /* Bong bóng chat - TRÁI / PHẢI */
    .msg-row {
        display: flex;
        margin-bottom: 8px;
        width: 100%;
    }

    .msg-row-mine {
        justify-content: flex-end; /* Tin của mình (Khách hàng) sang phải */
    }

    .msg-row-theirs {
        justify-content: flex-start; /* Tin của Shop sang trái */
    }

    .msg-bubble {
        max-width: 70%;
        padding: 8px 12px;
        font-size: 15px;
        line-height: 1.4;
        word-wrap: break-word;
        display: flex;
        flex-direction: column;
    }

    .msg-mine {
        background-color: #0084ff;
        color: #ffffff;
        border-radius: 18px 18px 4px 18px;
    }

    .msg-theirs {
        background-color: #e4e6eb;
        color: #050505;
        border-radius: 18px 18px 18px 4px;
    }

    .msg-time {
        font-size: 11px;
        margin-top: 4px;
        display: block;
        opacity: 0.7;
    }

    /* Khung nhập tin nhắn */
    .chat-input-area {
        padding: 15px;
        display: flex;
        align-items: center;
        border-top: 1px solid #e0e0e0;
    }

    .chat-input-box {
        flex: 1;
        background-color: #f0f2f5;
        border-radius: 20px;
        padding: 8px 15px;
        border: none;
        resize: none;
        outline: none;
        font-size: 15px;
        max-height: 100px;
        overflow-y: auto;
    }

    .btn-send-icon {
        color: #0084ff;
        background: transparent;
        border: none;
        font-size: 24px;
        padding: 0 10px 0 15px;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .btn-send-icon:hover {
            transform: scale(1.1);
        }

    /* Ẩn scrollbar */
    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #bcc0c4;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #90949c;
        }
</style>

<div class="container mt-4 mb-5">
    <div class="messenger-app shadow-sm">

        <!-- SIDEBAR: Danh sách hội thoại -->
        <div class="messenger-sidebar">
            <div class="sidebar-header">
                Tin nhắn của bạn
            </div>
            <div class="chat-list" id="chat-sidebar">
                @if (ViewBag.Conversations != null)
                {
                    foreach (var conv in ViewBag.Conversations)
                    {
                        <a href="@Url.Action("Index", "Chat", new { conversationId = conv.ConversationId })"
                           class="chat-item @(currentConversationId == conv.ConversationId ? "active" : "")"
                           id="conv-@conv.ConversationId">

                            <div class="avatar-circle">
                                <!-- Nếu có AvatarShop thì hiển thị, không thì dùng icon mặc định -->
                                @if (!string.IsNullOrEmpty(conv.PartnerAvatar))
                                {
                                    <img src="@conv.PartnerAvatar" alt="Avatar" />
                                }
                                else
                                {
                                    <i class="fas fa-store"></i>
                                }
                            </div>
                            <div class="chat-item-info">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="chat-item-name">@conv.PartnerName</div>
                                    @if (conv.UnreadCount > 0)
                                    {
                                        <span class="badge badge-danger badge-pill">@conv.UnreadCount</span>
                                    }
                                </div>
                                <div class="chat-item-preview" id="last-msg-@conv.ConversationId">
                                    @conv.LastMessage
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- KHUNG CHAT CHÍNH -->
        <div class="messenger-main">
            @if (currentConversationId.HasValue && activeConversation != null)
            {
                <!-- Header -->
                <div class="chat-header">
                    <div class="avatar-circle" style="width: 40px; height: 40px; font-size: 16px;">
                        @if (!string.IsNullOrEmpty(activeConversation.PartnerAvatar))
                        {
                            <img src="@activeConversation.PartnerAvatar" alt="Avatar" />
                        }
                        else
                        {
                            <i class="fas fa-store"></i>
                        }
                    </div>
                    <div class="chat-header-name ml-2">@activeConversation.PartnerName</div>
                </div>

                <!-- Khu vực hiển thị tin nhắn -->
                <div class="messages-container" id="messagesList">
                    @if (ViewBag.Messages != null)
                    {
                        foreach (var msg in ViewBag.Messages)
                        {
                            var isMine = msg.SenderId.ToString() == currentUserId;

                            <!-- Ép sang trái hoặc phải -->
                            <div class="msg-row @(isMine ? "msg-row-mine" : "msg-row-theirs")">
                                <div class="msg-bubble @(isMine ? "msg-mine" : "msg-theirs")">
                                    @msg.MessageText
                                    <span class="msg-time text-@(isMine ? "right" : "left")">
                                        @msg.SentAt.ToString("HH:mm")
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Khu vực nhập tin nhắn -->
                <div class="chat-input-area">
                    <textarea id="messageInput" class="chat-input-box" rows="1" placeholder="Nhập tin nhắn gửi tới Shop..."></textarea>
                    <button id="sendButton" class="btn-send-icon">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex h-100 justify-content-center align-items-center text-muted flex-column" style="background: #f0f2f5;">
                    <i class="fas fa-comments fa-4x mb-3 text-gray-400"></i>
                    <h5>Chọn một Shop để bắt đầu trò chuyện</h5>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- 1. Import SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>

    <script>
        const currentUserId = "@currentUserId";
        const currentConversationId = parseInt("@currentConversationId") || 0;

        // 2. Khởi tạo kết nối tới Hub
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        // 3. Xử lý nhận tin nhắn mới
        connection.on("ReceiveMessage", (message) => {
            if (currentConversationId !== 0) {
                const isMine = message.senderId.toString() === currentUserId;

                // Chọn đúng class ép lề Trái / Phải
                const rowClass = isMine ? "msg-row-mine" : "msg-row-theirs";
                const bubbleClass = isMine ? "msg-mine" : "msg-theirs";
                const alignTime = isMine ? "right" : "left";

                const msgHtml = `
                    <div class="msg-row ${rowClass}">
                        <div class="msg-bubble ${bubbleClass}">
                            ${message.messageText}
                            <span class="msg-time text-${alignTime}">Vừa xong</span>
                        </div>
                    </div>`;

                const messagesList = document.getElementById("messagesList");
                messagesList.insertAdjacentHTML('beforeend', msgHtml);
                messagesList.scrollTop = messagesList.scrollHeight; // Cuộn xuống cuối
            }
        });

        // 4. Xử lý cập nhật Sidebar
        connection.on("UpdateSidebar", (data) => {
            const lastMsgElement = document.getElementById(`last-msg-${data.conversationId}`);
            if (lastMsgElement) {
                lastMsgElement.innerText = data.lastMessage;
                // Đẩy hội thoại mới lên đầu danh sách
                const chatItem = document.getElementById(`conv-${data.conversationId}`);
                const chatList = document.getElementById('chat-sidebar');
                if(chatItem && chatList) {
                    chatList.prepend(chatItem);
                }
            }
        });

        // 5. Bắt đầu kết nối
        connection.start().then(() => {
            console.log("SignalR Connected.");

            // Tham gia kênh cá nhân nhận thông báo
            connection.invoke("JoinPersonalChannel", currentUserId);
            if (currentConversationId !== 0) {
                connection.invoke("JoinConversation", currentConversationId);

                // Cuộn xuống dòng tin nhắn mới nhất
                const messagesList = document.getElementById("messagesList");
                messagesList.scrollTop = messagesList.scrollHeight;
            }
        }).catch(err => console.error(err.toString()));

        // 6. Hàm xử lý gửi tin nhắn
        const sendMsg = () => {
            const messageInput = document.getElementById("messageInput");
            const text = messageInput.value.trim();

            if (text === "") return;

            connection.invoke("SendMessage", currentConversationId, currentUserId, "0", "Customer", text)
                .catch(err => console.error(err.toString()));

            messageInput.value = "";
            messageInput.focus();
        };

        // Gắn sự kiện Click nút Gửi
        document.getElementById("sendButton")?.addEventListener("click", sendMsg);

        // Hỗ trợ ấn Enter để gửi, Shift+Enter để xuống dòng
        document.getElementById("messageInput")?.addEventListener("keypress", function (e) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendMsg();
            }
        });
    </script>
}